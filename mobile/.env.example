# Copia este archivo a `.env` (no se sube a git) y completa los valores.
# Expo solo incluye en la app las variables que empiezan con EXPO_PUBLIC_, y
# todo lo que pongas aquí queda dentro de la app: es público. La clave
# publicable puede ir ahí porque los datos los protegen las políticas RLS.
# Para los builds de EAS se cargan con `eas env:create` (ver README).

# Proyecto de Supabase (los mismos valores que VITE_* de la web)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Web donde terminan los enlaces de los correos (confirmar cuenta, nueva clave)
EXPO_PUBLIC_WEB_URL=https://finanza-bay.vercel.app
