# Local (default): SQLite — no Docker needed
DB_CLIENT=sqlite
SQLITE_PATH=server/data/finanzas.sqlite

# MySQL (Docker / VPS only)
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=finanzas
MYSQL_USER=finanzas
MYSQL_PASSWORD=finanzas

# API
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
CORS_ORIGIN=*

# Web: puerto publicado en el host (Coolify usa su proxy; este mapeo es opcional)
WEB_PORT=3000
