# Proyecto de Supabase (Settings → API Keys). La clave publicable puede ir en
# el navegador: los datos los protegen las políticas RLS de la base.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Docker: puerto donde se publica la web
WEB_PORT=3000
